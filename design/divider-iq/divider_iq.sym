B 5 -132.5 17.5 -127.5 22.5 {name=RESETB dir=in}
B 5 127.5 -22.5 132.5 -17.5 {name=CLK dir=out}
B 5 127.5 17.5 132.5 22.5 {name=CLK90 dir=out}
